# Every run is a biomni A1 agent run against Groq's inference endpoint. There
# is no model to serve and no GPU in the loop — only the key below, which is
# the one thing here with no default.

# --- required --------------------------------------------------------------
# Your GroqCloud key, from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- the model -------------------------------------------------------------
# Which Groq model answers. It has to support tool calling (A1 calls its tools
# as code) and carry A1's ~35k-token system prompt on every step.
# Default: openai/gpt-oss-120b (131k context, reasoning in its own field).
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=qwen/qwen3.8-27b

# How much the model is asked to think, sent as the request's reasoning_effort.
# Which values are accepted depends on the model: low | medium | high for the
# GPT-OSS models, none | default for Qwen, xhigh only on Muse Spark. Unset
# leaves Groq's own default for that model alone.
# LLM_REASONING_EFFORT=high

# Groq's OpenAI-compatible endpoint. Only worth setting to reach it through a
# proxy. Default: https://api.groq.com/openai/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- rate limits -----------------------------------------------------------
# A hosted endpoint is up but limited per minute and per day, so a sweep long
# enough to be worth running will meet a 429. This is how many times one
# request waits it out before its batch or isolate is given up on. Groq says
# how long to wait and that is obeyed; otherwise the wait doubles per attempt.
# GROQ_MAX_RETRIES=5

# --- optional overrides ----------------------------------------------------
# BIOMNI_PATH=./data
# BIOMNI_TEMPERATURE=0.2
# BIOMNI_TIMEOUT_SECONDS=600
# Let A1 retrieve a relevant tool subset instead of carrying the whole
# catalogue in its system prompt (the --tools flag). Worth turning on here:
# that prompt is paid for on every step of every run.
# BIOMNI_USE_TOOL_RETRIEVER=false
# BIOMNI_LOAD_DATA_LAKE=false
