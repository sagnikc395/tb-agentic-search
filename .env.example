# Every run is a biomni A1 agent run against a model you serve yourself; there
# is no hosted provider and no API key. Two biomni backends do that, and both
# drive A1: Custom (any OpenAI-compatible server, i.e. vLLM) and Ollama.

# --- vLLM (the default; on Unity see scripts/serve_vllm_unity.sbatch) -------
# The server's URL. Default: http://localhost:8000/v1
# VLLM_BASE_URL=http://gpu042:8000/v1

# The id the server was started with. Default: Qwen/Qwen3-8B
# VLLM_MODEL=Qwen/Qwen3-8B

# How much the model is asked to think, sent as the request's reasoning_effort:
# none | minimal | low | medium | high | xhigh | max
# Needs the server started with --reasoning-parser for the traces to come back
# separated from the answer.
# LLM_REASONING_EFFORT=high

# --- Ollama (biomni's other local backend) ---------------------------------
# LLM_SOURCE=Ollama
# VLLM_MODEL=qwen3:8b

# Optional overrides
# BIOMNI_PATH=./data
# BIOMNI_TEMPERATURE=0.2
# BIOMNI_TIMEOUT_SECONDS=600
# Let A1 retrieve a relevant tool subset instead of carrying the whole
# catalogue in its system prompt (the --tools flag).
# BIOMNI_USE_TOOL_RETRIEVER=false
# BIOMNI_LOAD_DATA_LAKE=false
