# Required: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model id served over the OpenAI-compatible endpoint
GROQ_MODEL=openai/gpt-oss-120b

# Tells biomni which provider branch to use. Leave as Groq.
LLM_SOURCE=Groq

# Optional overrides
# BIOMNI_PATH=./data
# BIOMNI_TEMPERATURE=0.2
# BIOMNI_TIMEOUT_SECONDS=600
# BIOMNI_USE_TOOL_RETRIEVER=false
# BIOMNI_LOAD_DATA_LAKE=false
