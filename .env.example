# Copy this file to .env and set the values you need. Git ignores .env.

# mock: scripted offline client; the default when HF_TOKEN is unset
# huggingface: Qwen-3 through the HuggingFace Inference API
LLM_PROVIDER=mock

# HuggingFace access token (https://huggingface.co/settings/tokens)
# HUGGINGFACE_API_KEY is accepted as an alias.
HF_TOKEN=

# Any tool-calling model served on HuggingFace. Smaller Qwen-3 variants are useful
# for smoke tests; use a fixed model when comparing runs.
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
